@model Inventory.Domain.ViewModels.UserListItemVM

@{
    ViewData["Title"] = "Delete User";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-danger" style="max-width:480px;">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Delete User</h4>
    </div>
    <div class="card-body">
        <p class="mb-1">Are you sure you want to delete this user?</p>
        <ul class="list-unstyled mt-3 mb-4">
            <li><strong>Name:</strong> @Model.FullName</li>
            <li><strong>Email:</strong> @Model.Email</li>
            <li>
                <strong>Roles:</strong>
                @if (Model.Roles.Any())
                {
                    @string.Join(", ", Model.Roles)
                }
                else
                {
                    <span class="text-muted">None</span>
                }
            </li>
        </ul>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
