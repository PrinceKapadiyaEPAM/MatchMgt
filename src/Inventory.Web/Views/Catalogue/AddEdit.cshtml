@using Inventory.Domain.Entities
@model Catalogue
@{
    ViewData["Title"] = ViewBag.Action + " Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = (string)ViewBag.Action == "Edit";
}

@if (TempData["PriceWarning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["PriceWarning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">
            <i class="bi bi-box-seam me-2 text-muted"></i>@ViewBag.Action Product
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Save" method="post" enctype="multipart/form-data" autocomplete="off">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.Id)
            @Html.HiddenFor(x => x.PdfFileName)
            @Html.HiddenFor(x => x.PhotoFileName)

            <div class="row g-3">

                                <div class="col-md-8">
                    <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter catalogue name" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Fold</label>
                    <input asp-for="Fold" class="form-control" placeholder="e.g. 40×40" />
                </div>

                                <div class="col-md-4">
                    <label class="form-label fw-semibold">Price</label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    </div>
                    <div class="form-text">Leave blank for "Price on Request"</div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Restock Date</label>
                    <input asp-for="RestockDate" type="date" class="form-control" />
                    <div class="form-text">Shown on mobile when out of stock</div>
                </div>

                                <div class="col-12">
                    <label class="form-label fw-semibold">Remark</label>
                    <textarea asp-for="Remark" class="form-control" rows="3" placeholder="Enter remarks"></textarea>
                </div>

                                <div class="col-md-6">
                    <label class="form-label fw-semibold">Photo</label>
                    @if (Model != null && !string.IsNullOrEmpty(Model.PhotoFileName))
                    {
                        <div class="mb-2">
                            <img src="~/uploads/catalogues/@Model.PhotoFileName"
                                 style="max-height:100px;" class="img-thumbnail rounded" />
                        </div>
                    }
                    <input type="file" name="photo" accept="image/*" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Document (PDF)</label>
                    @if (Model != null && !string.IsNullOrEmpty(Model.PdfFileName))
                    {
                        <div class="mb-2">
                            <a class="btn btn-outline-secondary btn-sm" target="_blank"
                               href="~/uploads/catalogues/@Model.PdfFileName">
                                <i class="bi bi-file-earmark-pdf me-1"></i>View current document
                            </a>
                        </div>
                    }
                    <input type="file" name="pdf" accept="application/pdf" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label fw-semibold">Categories</label>
                    <select name="selectedCategoryIds" id="categorySelect" class="form-select" multiple>
                        @{
                            var selectedCatIds = (List<int>)(ViewBag.SelectedCategoryIds ?? new List<int>());
                        }
                        @foreach (var cat in (IEnumerable<Inventory.Domain.Entities.Category>)(ViewBag.AllCategories ?? new List<Inventory.Domain.Entities.Category>()))
                        {
                            if (selectedCatIds.Contains(cat.Id))
                            {
                                <option value="@cat.Id" selected>@cat.Name</option>
                            }
                            else
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                    </select>
                </div>

            </div>

            <hr class="mt-4" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-check-lg me-1"></i>@(isEdit ? "Update" : "Save")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $('#categorySelect').select2({
        theme: 'bootstrap-5',
        placeholder: 'Select categories...',
        width: '100%'
    });
</script>
}
