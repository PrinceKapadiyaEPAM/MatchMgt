@model List<Inventory.Domain.Entities.DispatchEntry>
@using Inventory.Domain.Entities
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Dispatch";

    var catalogueList = ViewBag.CatalogueList as List<Catalogue> ?? new List<Catalogue>();
    var foldList      = ViewBag.FoldList       as List<string>    ?? new List<string>();
    var agentList     = ViewBag.AgentList      as List<string>    ?? new List<string>();
    var transportList = ViewBag.TransportList  as List<string>    ?? new List<string>();
    var partyList     = ViewBag.PartyList      as List<Party>     ?? new List<Party>();

    var catalogueOptionsHtml = "<option value=\"\">--</option>" +
        string.Join("", catalogueList.Select(c =>
            $"<option value=\"{c.Id}\">{System.Net.WebUtility.HtmlEncode(c.Name)}</option>"));

    var foldOptionsHtml = "<option value=\"\">--</option>" +
        string.Join("", foldList.Select(f =>
            $"<option value=\"{System.Net.WebUtility.HtmlEncode(f)}\">{System.Net.WebUtility.HtmlEncode(f)}</option>"));

    var catalogueFoldsJson = "{" +
        string.Join(",", catalogueList
            .Where(c => c.Fold != null)
            .Select(c => $"{c.Id}:{System.Text.Json.JsonSerializer.Serialize(c.Fold)}")) +
        "}";

    var partyOptionsHtml = "<option value=\"\">--</option>" +
        string.Join("", partyList.Select(p =>
            $"<option value=\"{p.PartyId}\">{System.Net.WebUtility.HtmlEncode(p.PartyName)}</option>"));

    var targetDate    = (string)(ViewBag.TargetDate ?? DateTime.Today.ToString("yyyy-MM-dd"));
    var targetDisplay = DateOnly.Parse(targetDate).ToString("dd MMM yyyy");
    var isToday       = targetDate == DateTime.Today.ToString("yyyy-MM-dd");
}

<style>
    .dispatch-title { background:#70ad47; color:white; font-size:18px; font-weight:bold; text-align:center; padding:8px; border-radius:4px 4px 0 0; }
    .table-container { background:white; overflow-x:auto; border:1px solid #dee2e6; border-top:none; }
    #dispatchTable { min-width:2200px; margin-bottom:0; }
    #dispatchTable th { background:#d9ead3; text-align:center; vertical-align:middle; white-space:nowrap; font-size:13px; padding:5px 4px; }
    #dispatchTable td { padding:2px 2px !important; vertical-align:middle; }
    #dispatchTable input, #dispatchTable select { border:none !important; box-shadow:none !important; border-radius:0 !important; font-size:13px !important; padding:2px 4px !important; height:28px; background:transparent; }
    #dispatchTable input:focus, #dispatchTable select:focus { background:#fffde7 !important; outline:none; }
    #dispatchTable input:disabled, #dispatchTable select:disabled { background:transparent !important; opacity:1 !important; pointer-events:none; color:#212529; -webkit-appearance:none; appearance:none; }
    .status-ok { background:#d4edda !important; }
    .status-pending { background:#fff3cd !important; }
    .status-cancelled { background:#f8d7da !important; }
    @@keyframes flashGreen { 0% { background:#c3e6cb; } 100% { background:transparent; } }
    .row-saved { animation: flashGreen 0.7s ease; }
</style>

<datalist id="agentList">
    @foreach (var a in agentList) { <option value="@a"></option> }
</datalist>
<datalist id="transportList">
    @foreach (var t in transportList) { <option value="@t"></option> }
</datalist>

<div class="dispatch-title">
    @(isToday ? "TODAY'S DISPATCH" : "DISPATCH") — @targetDisplay
</div>
<div class="table-container">
    <table id="dispatchTable" class="table table-bordered table-sm mb-0">
        <thead>
            <tr>
                <th style="width:88px;">Action</th>
                <th>Date</th><th>Catalogue</th><th>Fold</th><th>Agent</th>
                <th>To Party</th><th>From</th><th>Transport</th><th>Station</th>
                <th>Bale</th><th>Remark</th><th>Bale No.</th>
                <th>Price</th><th>Status</th>
            </tr>
        </thead>
        <tbody id="dispatchBody">
            @foreach (var e in Model)
            {
                <tr data-id="@e.Id"
                    data-catalogue="@e.CatalogueId"
                    data-fold="@e.Fold"
                    data-toparty="@e.ToPartyId"
                    data-status="@e.Status">
                    <td class="text-center">
                        <button class="btn btn-success btn-sm p-1 lh-1 btn-save" style="display:none;" title="Save"><i class="bi bi-check-lg"></i></button>
                        <button class="btn btn-warning btn-sm p-1 lh-1 btn-edit" title="Edit"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-danger  btn-sm p-1 lh-1 btn-delete" title="Delete"><i class="bi bi-trash"></i></button>
                    </td>
                    <td><input type="date"   class="form-control form-control-sm" value="@e.Date.ToString("yyyy-MM-dd")" disabled /></td>
                    <td>
                        <select class="form-select form-select-sm sel-catalogue" disabled>
                            <option value="">--</option>
                            @foreach (var c in catalogueList) { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm sel-fold" disabled>
                            <option value="">--</option>
                            @foreach (var f in foldList) { <option value="@f">@f</option> }
                        </select>
                    </td>
                    <td><input type="text"   class="form-control form-control-sm" list="agentList"     value="@e.Agent" disabled /></td>
                    <td>
                        <select class="form-select form-select-sm sel-toparty" disabled>
                            <option value="">--</option>
                            @foreach (var p in partyList) { <option value="@p.PartyId">@p.PartyName</option> }
                        </select>
                    </td>
                    <td><input type="text"   class="form-control form-control-sm"                     value="@e.From"      disabled /></td>
                    <td><input type="text"   class="form-control form-control-sm" list="transportList" value="@e.Transport" disabled /></td>
                    <td><input type="text"   class="form-control form-control-sm"                     value="@e.Station"   disabled /></td>
                    <td><input type="number" class="form-control form-control-sm"                     value="@e.Bale"      disabled /></td>
                    <td><input type="text"   class="form-control form-control-sm"                     value="@e.Remark"    disabled /></td>
                    <td><input type="text"   class="form-control form-control-sm"                     value="@e.BaleNo"    disabled /></td>
                    <td><input type="number" step="0.01" class="form-control form-control-sm inp-price" value="@e.Price"   disabled /></td>
                    <td>
                        <select class="form-select form-select-sm status-select sel-status" disabled>
                            <option value="Ok">Ok</option>
                            <option value="Pending">Pending</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-2 d-flex justify-content-between align-items-center">
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-primary btn-sm" id="btnAddRow">+ Add Row</button>
        <small class="text-muted">@Model.Count row(s) today</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">View Full Register →</a>
</div>

@section Scripts {
<script>
    const catalogueFolds   = @Html.Raw(catalogueFoldsJson);
    const catalogueOptions = `@Html.Raw(catalogueOptionsHtml)`;
    const foldOptions      = `@Html.Raw(foldOptionsHtml)`;
    const partyOptions     = `@Html.Raw(partyOptionsHtml)`;
    const editId           = @(ViewBag.EditId ?? 0);

    function applyStatusColor(sel) {
        sel.classList.remove('status-ok','status-pending','status-cancelled');
        const map = { Ok:'status-ok', Pending:'status-pending', Cancelled:'status-cancelled' };
        if (map[sel.value]) sel.classList.add(map[sel.value]);
    }

    function bindCatalogueChange(row) {
        const catSel  = row.querySelector('.sel-catalogue');
        const foldSel = row.querySelector('.sel-fold');
        catSel.addEventListener('change', () => {
            const fold = catalogueFolds[catSel.value];
            if (fold != null) foldSel.value = fold;
        });
    }

    function bindRow(row) {
        const cat     = row.dataset.catalogue;
        const fold    = row.dataset.fold;
        const toParty = row.dataset.toparty;
        const status  = row.dataset.status;
        if (cat)     row.querySelector('.sel-catalogue').value = cat;
        if (fold)    row.querySelector('.sel-fold').value      = fold;
        if (toParty) row.querySelector('.sel-toparty').value   = toParty;
        const statusSel = row.querySelector('.sel-status');
        if (status) statusSel.value = status;
        applyStatusColor(statusSel);
        statusSel.addEventListener('change', () => applyStatusColor(statusSel));
        bindCatalogueChange(row);
        row.querySelector('.btn-save').addEventListener('click',   () => saveRow(row));
        row.querySelector('.btn-edit').addEventListener('click',   () => enterEdit(row));
        row.querySelector('.btn-delete').addEventListener('click', () => deleteRow(row));
        const statusTd = statusSel.closest('td');
        statusTd.style.cursor = 'pointer';
        statusTd.title = 'Double-click to edit status';
        statusTd.addEventListener('dblclick', () => enableStatusEdit(row));
    }

    function enableStatusEdit(row) {
        if (row.querySelector('.btn-edit').style.display === 'none') return;
        const statusSel = row.querySelector('.sel-status');
        statusSel.disabled = false;
        statusSel.focus();
        let changed = false;
        function onchange() {
            changed = true;
            statusSel.removeEventListener('change', onchange);
            statusSel.removeEventListener('blur', onblur);
            const id = parseInt(row.dataset.id);
            if (id) patchStatus(row, statusSel.value);
            else    saveRow(row, { addNewRow: false });
        }
        function onblur() {
            if (!changed) {
                statusSel.removeEventListener('change', onchange);
                statusSel.disabled = true;
            }
        }
        statusSel.addEventListener('change', onchange);
        statusSel.addEventListener('blur', onblur);
    }

    async function patchStatus(row, newStatus) {
        const res  = await fetch('/Dispatch/PatchStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: parseInt(row.dataset.id), status: newStatus })
        });
        const json = await res.json();
        if (json.success) {
            row.dataset.status = newStatus;
            row.querySelector('.sel-status').disabled = true;
            row.classList.remove('status-ok', 'status-pending', 'status-cancelled');
            const map = { Ok: 'status-ok', Pending: 'status-pending', Cancelled: 'status-cancelled' };
            if (map[newStatus]) row.classList.add(map[newStatus]);
        } else {
            alert('Save failed: ' + (json.error ?? 'Unknown error'));
            row.querySelector('.sel-status').value    = row.dataset.status || 'Pending';
            row.querySelector('.sel-status').disabled = true;
        }
    }

    function enterEdit(row) {
        row.querySelectorAll('input, select').forEach(el => {
            el.disabled = false;
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); saveRow(row); }
            });
        });
        row.querySelector('.btn-edit').style.display = 'none';
        row.querySelector('.btn-save').style.display = '';
        const statusTd = row.querySelector('.sel-status').closest('td');
        statusTd.style.cursor = 'default'; statusTd.title = '';
    }

    function getRowData(row) {
        const cells = row.querySelectorAll('input, select');
        const [date, catalogue, fold, agent, toParty, from, transport, station, bale, remark, baleNo, price, status] = cells;
        return {
            id:          parseInt(row.dataset.id) || 0,
            date:        date.value || null,
            catalogueId: catalogue.value ? parseInt(catalogue.value) : null,
            fold:        fold.value      || null,
            agent:       agent.value     || null,
            toPartyId:   toParty.value   ? parseInt(toParty.value) : null,
            from:        from.value      || null,
            transport:   transport.value || null,
            station:     station.value   || null,
            bale:        bale.value   !== '' ? parseInt(bale.value)    : null,
            remark:      remark.value    || null,
            baleNo:      baleNo.value    || null,
            price:       price.value  !== '' ? parseFloat(price.value) : null,
            status:      status.value
        };
    }

    async function saveRow(row, { addNewRow = true } = {}) {
        const data = getRowData(row);
        const btn  = row.querySelector('.btn-save');
        btn.disabled = true; btn.textContent = '...';
        try {
            const res  = await fetch('/Dispatch/SaveRow', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const json = await res.json();
            if (json.success) {
                row.dataset.id = json.id;
                row.querySelectorAll('input, select').forEach(el => el.disabled = true);
                row.querySelector('.btn-save').style.display   = 'none';
                row.querySelector('.btn-edit').style.display   = '';
                row.querySelector('.btn-delete').style.display = '';
                const statusTd = row.querySelector('.sel-status').closest('td');
                statusTd.style.cursor = 'pointer'; statusTd.title = 'Double-click to change status';
                row.classList.remove('status-ok', 'status-pending', 'status-cancelled');
                const statusMap = { Ok: 'status-ok', Pending: 'status-pending', Cancelled: 'status-cancelled' };
                if (statusMap[data.status]) row.classList.add(statusMap[data.status]);
                row.classList.add('row-saved');
                setTimeout(() => row.classList.remove('row-saved'), 700);
                if (addNewRow) {
                    const newRow = createNewRow();
                    document.getElementById('dispatchBody').prepend(newRow);
                    newRow.querySelector('input[type="date"]').focus();
                }
            } else {
                alert('Save failed: ' + (json.error ?? 'Unknown error'));
            }
        } catch (e) {
            alert('Network error: ' + e.message);
        } finally {
            btn.disabled = false; btn.textContent = 'Save';
        }
    }

    async function deleteRow(row) {
        if (!confirm('Delete this row?')) return;
        const id = parseInt(row.dataset.id);
        if (!id) { row.remove(); return; }
        const res  = await fetch('/Dispatch/DeleteRow', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(id)
        });
        const json = await res.json();
        if (json.success) row.remove(); else alert('Delete failed.');
    }

    function createNewRow() {
        const tr    = document.createElement('tr');
        tr.dataset.id = '0';
        const today = new Date().toISOString().slice(0, 10);
        tr.innerHTML = `
            <td class="text-center">
                <button class="btn btn-success btn-sm p-1 lh-1 btn-save" title="Save"><i class="bi bi-check-lg"></i></button>
                <button class="btn btn-warning btn-sm p-1 lh-1 btn-edit" style="display:none;" title="Edit"><i class="bi bi-pencil"></i></button>
                <button class="btn btn-danger  btn-sm p-1 lh-1 btn-delete" style="display:none;" title="Delete"><i class="bi bi-trash"></i></button>
            </td>
            <td><input type="date"   class="form-control form-control-sm" value="${today}" /></td>
            <td><select class="form-select form-select-sm sel-catalogue">${catalogueOptions}</select></td>
            <td><select class="form-select form-select-sm sel-fold">${foldOptions}</select></td>
            <td><input type="text"   class="form-control form-control-sm" list="agentList" /></td>
            <td><select class="form-select form-select-sm sel-toparty">${partyOptions}</select></td>
            <td><input type="text"   class="form-control form-control-sm" /></td>
            <td><input type="text"   class="form-control form-control-sm" list="transportList" /></td>
            <td><input type="text"   class="form-control form-control-sm" /></td>
            <td><input type="number" class="form-control form-control-sm" /></td>
            <td><input type="text"   class="form-control form-control-sm" /></td>
            <td><input type="text"   class="form-control form-control-sm" /></td>
            <td><input type="number" step="0.01" class="form-control form-control-sm inp-price" /></td>
            <td><select class="form-select form-select-sm status-select sel-status">
                    <option value="Ok">Ok</option>
                    <option value="Pending" selected>Pending</option>
                    <option value="Cancelled">Cancelled</option>
                </select></td>`;
        const statusSel = tr.querySelector('.sel-status');
        applyStatusColor(statusSel);
        statusSel.addEventListener('change', () => applyStatusColor(statusSel));
        bindCatalogueChange(tr);
        tr.querySelector('.btn-save').addEventListener('click',   () => saveRow(tr));
        tr.querySelector('.btn-edit').addEventListener('click',   () => enterEdit(tr));
        tr.querySelector('.btn-delete').addEventListener('click', () => deleteRow(tr));
        tr.querySelectorAll('input, select').forEach(el => {
            el.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); saveRow(tr); }
            });
        });
        return tr;
    }

    document.getElementById('btnAddRow').addEventListener('click', () => {
        const row = createNewRow();
        document.getElementById('dispatchBody').prepend(row);
        row.querySelector('input[type="date"]').focus();
    });

    document.getElementById('dispatchBody').querySelectorAll('tr').forEach(row => {
        bindRow(row);
        if (editId && parseInt(row.dataset.id) === editId) {
            enterEdit(row);
            row.scrollIntoView({ block: 'center' });
        }
    });

    // Auto-add a blank row on page load so the user can start entering immediately
    if (!editId) {
        const row = createNewRow();
        document.getElementById('dispatchBody').prepend(row);
        row.querySelector('input[type="date"]').focus();
    }
</script>
}
