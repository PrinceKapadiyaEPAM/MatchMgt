@model Inventory.Domain.Entities.B2BUser
@{ ViewData["Title"] = "Delete B2B User"; }

<div class="card shadow-sm" style="max-width:500px">
    <div class="card-header bg-danger text-white">Delete B2B User</div>
    <div class="card-body">
        <p>Are you sure you want to delete <strong>@Model.FullName</strong> (@Model.Email)?</p>
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
