@model Inventory.Web.ViewModels.B2BUserEditVM
@{
    ViewData["Title"] = ViewBag.Action + " B2B User";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">@ViewBag.Action B2B User</h4>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<div class="card shadow-sm" style="max-width:600px">
    <div class="card-body">
        <form asp-action="Save" method="post">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.Id)

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">
                    Password @(ViewBag.Action == "Create" ? Html.Raw("<span class='text-danger'>*</span>") : Html.Raw("<small class='text-muted'>(leave blank to keep current)</small>"))
                </label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PartyId" class="form-label">Party <small class="text-muted">(optional)</small></label>
                <select asp-for="PartyId" id="partySelect" class="form-select">
                    <option value="">-- None (Guest User) --</option>
                    @foreach (var p in Model.Parties)
                    {
                        <option value="@p.PartyId" selected="@(Model.PartyId == p.PartyId)">@p.PartyName</option>
                    }
                </select>
                <div id="guestNote" class="alert alert-info mt-2 py-2 @(Model.PartyId == null ? "" : "d-none")" style="font-size:.875rem">
                    <i class="bi bi-info-circle"></i> <strong>Guest User</strong> — This user will see default prices only. No Party-specific pricing applies.
                </div>
            </div>

            @if (ViewBag.Action == "Edit")
            {
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false, null, new { @class = "mb-0" })
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> @(ViewBag.Action == "Create" ? "Create User" : "Save Changes")
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
document.getElementById('partySelect').addEventListener('change', function() {
    document.getElementById('guestNote').classList.toggle('d-none', !!this.value);
});
</script>
}
