@model Inventory.Domain.ViewModels.PaginatedList<Inventory.Domain.Entities.B2BUser>
@{
    ViewData["Title"] = "B2B Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">B2B Users</h4>
    <a asp-action="AddEdit" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-circle"></i> Add B2B User
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm mb-3">
    <div class="card-body p-2">
        <form method="get" class="row g-2">
            <div class="col-md-5">
                <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name or email..." />
            </div>
            <div class="col-md-3">
                <select name="approvalStatus" class="form-select form-select-sm">
                    <option value="">All Status</option>
                    <option value="Pending" selected="@(ViewBag.ApprovalStatus == "Pending")">Pending</option>
                    <option value="Approved" selected="@(ViewBag.ApprovalStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(ViewBag.ApprovalStatus == "Rejected")">Rejected</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-outline-secondary w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header table-dark py-2">B2B User List</div>
    <div class="card-body p-0">
        <table class="table table-striped table-bordered table-hover table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Party</th>
                    <th>Approval</th>
                    <th>Active</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int sr = (Model.PageIndex - 1) * Model.PageSize + 1; }
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td>@(sr++)</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Party != null)
                            {
                                <span>@u.Party.PartyName</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Guest</span>
                            }
                        </td>
                        <td>
                            @if (u.ApprovalStatus == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (u.ApprovalStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>
                            @if (u.ApprovalStatus == "Approved")
                            {
                                <button class="btn btn-sm @(u.IsActive ? "btn-success" : "btn-outline-secondary")"
                                        onclick="toggleActive(@u.Id, this)" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(u.IsActive ? "bi-check-circle" : "bi-x-circle")"></i>
                                </button>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="AddEdit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            <a asp-action="AccessRights" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning" title="Access Rights"><i class="bi bi-shield-lock"></i></a>
                            @if (u.ApprovalStatus == "Pending")
                            {
                                <form asp-action="Approve" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-success" title="Approve"><i class="bi bi-check-lg"></i></button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@u.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Reject this user?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-danger" title="Reject"><i class="bi bi-x-lg"></i></button>
                                </form>
                            }
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-3">No B2B users found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex - 1)"
                       asp-route-search="@ViewBag.Search" asp-route-approvalStatus="@ViewBag.ApprovalStatus">«</a>
                </li>
            }
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i"
                       asp-route-search="@ViewBag.Search" asp-route-approvalStatus="@ViewBag.ApprovalStatus">@i</a>
                </li>
            }
            @if (Model.HasNextPage)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.PageIndex + 1)"
                       asp-route-search="@ViewBag.Search" asp-route-approvalStatus="@ViewBag.ApprovalStatus">»</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
<script>
async function toggleActive(id, btn) {
    const res = await fetch('/B2BUsers/ToggleActive', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(id)
    });
    const data = await res.json();
    if (data.success) {
        btn.className = data.isActive ? 'btn btn-sm btn-success' : 'btn btn-sm btn-outline-secondary';
        btn.querySelector('i').className = data.isActive ? 'bi bi-check-circle' : 'bi bi-x-circle';
        btn.title = data.isActive ? 'Deactivate' : 'Activate';
    }
}
</script>
}
